FROM php:8.3-cli
# zip ต้องมี libzip-dev; mysqli สำหรับ DB; gd สำหรับ captcha/รูป
RUN apt-get update -qq && apt-get install -y -qq libzip-dev zlib1g-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install mysqli zip gd
